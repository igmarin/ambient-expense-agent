# Google AI Studio Authentication
# Obtain your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# OR

# Google Cloud Vertex AI Authentication
# Set these if using Vertex AI instead of Google AI Studio
GOOGLE_CLOUD_PROJECT=your_project_id_here
GOOGLE_CLOUD_LOCATION=us-central1 # or global
